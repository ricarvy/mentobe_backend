# Database
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/db_name?charset=utf8mb4

# App Config
APP_NAME="Mentob AI"
APP_VERSION="1.0.0"

# LLM Config
LLM_MODEL="doubao-seed-1-6-flash-250828"
LLM_TEMPERATURE=0.8
ARK_API_KEY=your_ark_api_key
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3" # or https://ark.ap-southeast-1.volces.com/api/v3 for oversea
TAROT_SYSTEM_PROMPT="Your tarot system prompt here..."

# Demo Account
DEMO_ACCOUNT_ENABLED=True
DEMO_ACCOUNT_EMAIL="demo@example.com"
DEMO_ACCOUNT_PASSWORD="ChangeMe!"

# Stripe Config
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_BASE="https://api.stripe.com"

# Stripe Prices
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_YEARLY=price_...
